						<version>${plugin.jxr.version}</version>
						<executions>
							<execution>
								<id>cross-reference-source</id>
								<phase>pre-site</phase>
								<goals>
									<goal>jxr</goal>
									<goal>test-jxr</goal>
								</goals>
